# Copy this file to .env and fill in your key.
# Used only by /api/claim-assistant.js on the server — never exposed to the browser.

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional — defaults to openai/gpt-4o-mini if unset. Any model at
# https://openrouter.ai/models works here.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional — used only for OpenRouter's attribution header.
SITE_URL=https://unclaimed-india.vercel.app
